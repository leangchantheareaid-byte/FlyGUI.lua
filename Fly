-- ===== SCAN LOGIC =====
local function clearList()
    for _, child in ipairs(scrollFrame:GetChildren()) do
        if child:IsA("Frame") or child:IsA("TextButton") then
            child:Destroy()
        end
    end
    folderData = {}
    checkboxes = {}
end

local function buildList(groups)
    clearList()
    emptyLabel.Visible = (#groups == 0)
    countLabel.Text = #groups .. " folder" .. (#groups == 1 and "" or "s") .. " found"

    for i, group in ipairs(groups) do
        local key = tostring(i)
        local entry = {
            name = group.name,
            instance = group.instance,
            anims = group.anims,
            selected = false,
            key = key,
        }
        table.insert(folderData, entry)

        -- Row frame
        local row = Instance.new("Frame")
        row.Name = key
        row.Size = UDim2.new(1, 0, 0, 38)
        row.BackgroundColor3 = BG_ITEM
        row.BorderSizePixel = 0
        row.Parent = scrollFrame
        makeCorner(row, 5)

        local rowPad = Instance.new("UIPadding")
        rowPad.PaddingLeft = UDim.new(0, 8)
        rowPad.PaddingRight = UDim.new(0, 8)
        rowPad.Parent = row

        -- Checkbox
        local box, tick = makeCheckbox(row, 16)
        box.Position = UDim2.new(0, 0, 0.5, -8)

        -- Folder name
        local nameL = makeLabel(row, group.name, 13, TEXT_MAIN)
        nameL.Size = UDim2.new(1, -80, 0, 18)
        nameL.Position = UDim2.new(0, 24, 0, 6)
        nameL.TextTruncate = Enum.TextTruncate.AtEnd

        -- Anim count
        local countL = makeLabel(row, #group.anims .. " anim" .. (#group.anims == 1 and "" or "s"), 11, TEXT_DIM)
        countL.Size = UDim2.new(0, 60, 0, 14)
        countL.Position = UDim2.new(0, 24, 0, 20)

        -- Path hint
        local pathL = makeLabel(row, group.path, 10, TEXT_DIM)
        pathL.Size = UDim2.new(1, -90, 0, 14)
        pathL.Position = UDim2.new(0, 90, 0, 20)
        pathL.TextTruncate = Enum.TextTruncate.AtEnd
        pathL.TextColor3 = Color3.fromRGB(90, 90, 120)

        -- Click to toggle
        local clickBtn = Instance.new("TextButton")
        clickBtn.Size = UDim2.new(1, 0, 1, 0)
        clickBtn.BackgroundTransparency = 1
        clickBtn.Text = ""
        clickBtn.Parent = row

        clickBtn.MouseButton1Click:Connect(function()
            entry.selected = not entry.selected
            setCheckbox(box, tick, entry.selected)
            row.BackgroundColor3 = entry.selected and BG_ITEM_SEL or BG_ITEM
        end)

        checkboxes[key] = { box = box, tick = tick, entry = entry, row = row }
        entry.row = row
    end
end

local function doScan()
    scanStatus.Text = "Scanning..."
    scanBtn.Active = false
    task.wait()

    local groups = {}
    local groupMap = {}  -- parent path -> group

    local function getPath(inst)
        local parts = {}
        local cur = inst
        while cur and cur ~= game do
            table.insert(parts, 1, cur.Name)
            cur = cur.Parent
        end
        return table.concat(parts, ".")
    end

    for _, desc in ipairs(game:GetDescendants()) do
        if desc:IsA("Animation") and desc.AnimationId ~= "" then
            local parent = desc.Parent
            if parent then
                local pPath = getPath(parent)
                if not groupMap[pPath] then
                    groupMap[pPath] = {
                        name = parent.Name,
                        instance = parent,
                        path = pPath,
                        anims = {},
                    }
                    table.insert(groups, groupMap[pPath])
                end
                table.insert(groupMap[pPath].anims, desc)
            end
        end
    end

    buildList(groups)

    local total = 0
    for _, g in ipairs(groups) do total = total + #g.anims end
    scanStatus.Text = #groups .. " folders, " .. total .. " anims total"
    scanBtn.Active = true
end

scanBtn.MouseButton1Click:Connect(function()
    task.spawn(doScan)
end)

